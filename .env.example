# Supabase (EU / Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Resend (email out)
RESEND_API_KEY=

# Inbound email webhook (Postmark / Cloudflare)
INBOUND_EMAIL_WEBHOOK_SECRET=

# Web push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Επαφή για τα push services: mailto:εσύ@domain.gr ή το https URL της εφαρμογής
# VAPID_SUBJECT=https://example.com

# Extraction provider: gemini (free, dev) | anthropic (prod)
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Reminders (Edge Function secrets: βάλ'τα στο supabase/functions/.env, ΟΧΙ εδώ)
# REMINDER_CRON_SECRET=
# RESEND_FROM=Θύμισέ μου <onboarding@resend.dev>
# SITE_URL=http://localhost:3000
